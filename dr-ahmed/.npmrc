# Dr. Ahmed Pharmacy — pnpm configuration

# Always hoist packages to the root node_modules so Vite, TanStack, and
# TailwindCSS plugins resolve without symlink issues.
shamefully-hoist=true

# Enable strict peer dependency validation
strict-peer-dependencies=false

# Use the fastest package resolution strategy
resolution-mode=lowest-direct

# Store deduplicated packages globally for faster installs
# (default location: ~/.local/share/pnpm/store)

